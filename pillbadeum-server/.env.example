# 이 파일을 .env로 복사해 개인 값을 채우세요. .env는 Git에 올리지 않습니다.
# Spring의 properties 형식으로 읽으므로 값에 따옴표를 붙이지 않습니다.
# %2B09:00은 +09:00의 URL 표현입니다. MySQL 시간대 표가 없어도 한국 시간으로 연결합니다.
DB_URL=jdbc:mysql://localhost:3306/pilldb?connectionTimeZone=%2B09:00&forceConnectionTimeZoneToSession=true
# 로컬 MySQL 계정을 입력합니다. 공유 예제에서는 비워둡니다.
DB_USERNAME=
DB_PASSWORD=

# 필수: Base64URL로 인코딩한 32바이트 이상의 개인 서명키. README에서 생성 방법을 확인하세요.
JWT_SECRET=

# 선택: 비워두면 해당 외부 기능만 사용할 수 없습니다.
OPENAI_API_KEY=
# 질문 분류(CHAT-005): Decisions API 모델. 현재 공식 지원 모델은 gpt-6-luna입니다.
# 분류를 사용할 때 OPENAI_DECISION_MODEL=gpt-6-luna로 지정합니다.
OPENAI_DECISION_MODEL=gpt-6-luna
# AI 기능을 사용할 때 계정에서 사용 가능한 Responses API 모델 ID를 명시합니다.
# 비워 두면 해당 생성 기능만 503으로 거절합니다. 임베딩 모델은 별도입니다.
OPENAI_CHAT_MODEL=gpt-6-luna
# 대화 답변만 high로 사용함. IDE/OS 환경변수로도 설정하며 공통·OCR effort는 별도임.
OPENAI_CHAT_REASONING_EFFORT=high
OPENAI_VISION_MODEL=gpt-6-luna
# 처방전 전용 모델/effort 기본값임. Responses의 max_output_tokens는 보내지 않음.
OPENAI_PRESCRIPTION_MODEL=gpt-6-luna
OPENAI_PRESCRIPTION_REASONING_EFFORT=max
PRESCRIPTION_OCR_TIMEOUT_MS=60000
PILL_TIMEOUT_MS=85000
# 선택: 일정 저장 완료 음성에 사용할 Speech API 모델. 예: gpt-4o-mini-tts (계정 사용 가능 여부 확인)
OPENAI_TTS_MODEL=
# OPENAI_TTS_VOICE=coral
# 선택: 실시간 음성 대화. 일정 항목 해석에는 위 OPENAI_CHAT_MODEL도 필요합니다.
# OPENAI_LIVE_MODEL=gpt-live-1
# OPENAI_LIVE_VOICE=marin
# OPENAI_LIVE_MAX_SECONDS=60
# OPENAI_LIVE_MAX_SESSIONS=10
PUBLIC_DATA_SERVICE_KEY=

# 선택: 복약 알림 웹 푸시(VAPID) 키. 세 값을 함께 넣거나 모두 비웁니다. 비우면 푸시 API만 503입니다.
# 개인 키는 공유하지 않습니다. 생성 방법은 README의 '복약 알림 키'를 보세요.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: 또는 https:// 로 시작하는 연락처. 브라우저 푸시 서비스가 문제 시 연락하는 주소입니다.
VAPID_SUBJECT=

# 선택: Qdrant(벡터 검색). Docker로 Qdrant를 띄운 사람만 주석을 해제합니다. (README 4번)
# QDRANT_ENABLED=true
# QDRANT_HOST=localhost
# QDRANT_PORT=6334
# QDRANT_COLLECTION_PREFIX=chat_memory
# QDRANT_VECTOR_SIZE=1536

# 필요할 때만 주석을 해제합니다.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SERVER_PORT=8080
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=max
# PUBLIC_DATA_READ_TIMEOUT_MS=10000
# OPENAI_DECISION_INPUT_USD_PER_MILLION=0.10
# OPENAI_MAX_CONCURRENT_CALLS=4
# OPENAI_PERMIT_TIMEOUT_MS=10000
# PUBLIC_DATA_MAX_CONCURRENT_CALLS=4
# PUBLIC_DATA_PERMIT_TIMEOUT_MS=10000
# FILE_UPLOAD_PATH_WINDOWS=C:/myWs/pillbadeum-uploads
# FILE_UPLOAD_PATH_MAC=/myWs/pillbadeum-uploads

# Docker MySQL을 사용하는 경우에만 관리자 비밀번호를 별도로 입력합니다.
# MYSQL_ROOT_PASSWORD=
# MYSQL_PORT=3306

# 낱알 v1 상세 진입. false여도 이름 검색·처방전·TTL 정리는 유지함.
PILL_IDENTIFICATION_ENABLED=true
